{
  "name": "unforged",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p infra && tsc --noEmit -p web",
    "check": "pnpm typecheck && vitest run",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "synth": "pnpm build:web && cdk synth",
    "deploy": "pnpm build:web && cdk deploy --require-approval never",
    "measure:race": "tsx scripts/race.ts",
    "measure:replay": "tsx scripts/replay.ts",
    "measure:dkim": "tsx scripts/dkim-latency.ts",
    "measure:forgery": "tsx scripts/forgery.ts",
    "measure:tamper": "tsx scripts/tamper.ts",
    "measure:signature": "tsx scripts/signature.ts",
    "measure:record-race": "tsx scripts/record-race.ts",
    "measure:receipt": "tsx scripts/verify-receipt.ts",
    "measure:chain": "tsx scripts/audit-chain.ts",
    "measure:receipt-race": "tsx scripts/receipt-race.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1144.0",
    "@aws-sdk/client-kms": "^3.1144.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/client-textract": "^3.1144.0",
    "@aws-sdk/dsql-signer": "^3.1144.0",
    "mailauth": "^7.1.0",
    "mailparser": "^3.9.32",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
